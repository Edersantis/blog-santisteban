---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { Font } from 'astro:assets';
import { AUTHOR_PROFILE, DEFAULT_OG_IMAGE, OG_LOCALE, SITE_DESCRIPTION, SITE_TITLE, X_HANDLE } from '../consts';

export type Breadcrumb = { name: string; url: string };

interface Props {
	title: string;
	/** Título completo para <title>, sin añadir el nombre del blog. */
	fullTitle?: string;
	description: string;
	image?: ImageMetadata;
	imageAlt?: string;
	ogType?: 'website' | 'article';
	pageType?: 'WebPage' | 'CollectionPage';
	pubDate?: Date;
	updatedDate?: Date;
	author?: string;
	tags?: string[];
	section?: string;
	breadcrumbs?: Breadcrumb[];
	noindex?: boolean;
}

const {
	title,
	fullTitle,
	description,
	image,
	imageAlt,
	ogType = 'website',
	pageType = 'WebPage',
	pubDate,
	updatedDate,
	author,
	tags = [],
	section,
	breadcrumbs = [],
	noindex = false,
} = Astro.props;

const site = Astro.site!;
const canonicalURL = new URL(Astro.url.pathname, site);
/* Los títulos largos van solos para que no se corten en los resultados de búsqueda. */
const pageTitle = fullTitle ?? (title === SITE_TITLE || title.length > 60 ? title : `${title} · ${AUTHOR_PROFILE.name}`);

/* Imagen social en 1200 × 630, el tamaño que recomiendan Facebook, LinkedIn y X. */
const OG_WIDTH = 1200;
const OG_HEIGHT = 630;
const preview = image ? await getImage({ src: image, width: OG_WIDTH, height: OG_HEIGHT, fit: 'cover', format: 'jpg' }) : null;
const socialImage = new URL(preview?.src ?? DEFAULT_OG_IMAGE, site);
const socialImageAlt = imageAlt || pageTitle;

const authorURL = AUTHOR_PROFILE.url;
const authorId = AUTHOR_PROFILE.id;
const websiteId = new URL('/#website', site).href;
const pageId = canonicalURL.href + '#webpage';

const person = {
	'@type': 'Person',
	'@id': authorId,
	name: AUTHOR_PROFILE.name,
	url: authorURL,
	image: new URL('/eder-santisteban.png', site).href,
	jobTitle: AUTHOR_PROFILE.jobTitle,
	description: AUTHOR_PROFILE.description,
	knowsAbout: AUTHOR_PROFILE.knowsAbout,
	homeLocation: { '@type': 'Place', name: 'Guatemala' },
	worksFor: AUTHOR_PROFILE.organizations.map((org) => ({ '@type': org.type, name: org.name, ...(org.url ? { url: org.url } : {}) })),
	sameAs: AUTHOR_PROFILE.sameAs,
};

const website = {
	'@type': 'WebSite',
	'@id': websiteId,
	url: site.href,
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	inLanguage: 'es',
	author: { '@id': authorId },
	publisher: { '@id': authorId },
};

const breadcrumbList =
	breadcrumbs.length > 0
		? {
				'@type': 'BreadcrumbList',
				'@id': canonicalURL.href + '#breadcrumb',
				itemListElement: breadcrumbs.map((crumb, index) => ({
					'@type': 'ListItem',
					position: index + 1,
					name: crumb.name,
					item: new URL(crumb.url, site).href,
				})),
			}
		: null;

const webPage = {
	'@type': pageType,
	'@id': pageId,
	url: canonicalURL.href,
	name: pageTitle,
	description,
	inLanguage: 'es',
	isPartOf: { '@id': websiteId },
	...(breadcrumbList ? { breadcrumb: { '@id': breadcrumbList['@id'] } } : {}),
	...(Astro.url.pathname === '/' ? { about: { '@id': authorId } } : {}),
};

const article =
	ogType === 'article' && pubDate
		? {
				'@type': 'BlogPosting',
				'@id': canonicalURL.href + '#article',
				headline: title,
				url: canonicalURL.href,
				description,
				datePublished: pubDate.toISOString(),
				dateModified: (updatedDate ?? pubDate).toISOString(),
				author: { '@id': authorId },
				publisher: { '@id': authorId },
				image: {
					'@type': 'ImageObject',
					url: socialImage.href,
					width: image ? OG_WIDTH : 1200,
					height: image ? OG_HEIGHT : 630,
				},
				mainEntityOfPage: { '@id': pageId },
				isPartOf: { '@id': websiteId },
				inLanguage: 'es',
				...(section ? { articleSection: section } : {}),
				keywords: tags.join(', '),
			}
		: null;

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [website, person, webPage, breadcrumbList, article].filter(Boolean),
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#090909" />
<script is:inline>
	(function () {
		try {
			if (localStorage.getItem('theme') === 'light') {
				document.documentElement.dataset.theme = 'light';
				var meta = document.querySelector('meta[name="theme-color"]');
				if (meta) meta.setAttribute('content', '#f6f3ec');
			}
		} catch (e) {}
	})();
</script>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
<link rel="alternate" type="text/plain" title="llms.txt" href={new URL('llms.txt', Astro.site)} />
<link rel="me" href={AUTHOR_PROFILE.url} />
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-display" preload />
<Font cssVariable="--font-sans" preload />
<Font cssVariable="--font-mono" />
<Font cssVariable="--font-display-italic" />

{!noindex && <link rel="canonical" href={canonicalURL} />}

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large"} />
<meta name="author" content={author ?? "Eder Santisteban"} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={OG_LOCALE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:alt" content={socialImageAlt} />
<meta property="og:image:type" content={image ? 'image/jpeg' : 'image/png'} />
<meta property="og:image:width" content={String(OG_WIDTH)} />
<meta property="og:image:height" content={String(OG_HEIGHT)} />

<meta name="twitter:site" content={X_HANDLE} />
<meta name="twitter:creator" content={X_HANDLE} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={socialImageAlt} />

{
	ogType === 'article' && pubDate && (
		<>
			<meta property="article:published_time" content={pubDate.toISOString()} />
			{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
			{author && <meta property="article:author" content={authorURL} />}
			{section && <meta property="article:section" content={section} />}
			{tags.map((tag) => <meta property="article:tag" content={tag} />)}
		</>
	)
}

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
