---
import { tagHref } from '../lib/posts';

interface Props {
	tags: string[];
}

const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class="tag-list">
			{tags.map((tag) => (
				<li>
					<a href={tagHref(tag)}>{tag}</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		padding: 0;
		margin: 0.75rem 0 0;
	}
	.tag-list a {
		display: inline-block;
		padding: 0.05rem 0.65rem;
		border-radius: 999px;
		background: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 0.85rem;
	}
	.tag-list a:hover {
		color: var(--accent);
	}
</style>
