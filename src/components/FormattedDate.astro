---
interface Props {
	date: Date;
	format?: 'long' | 'short';
}

const { date, format = 'long' } = Astro.props;

/** Las fechas se muestran en la hora de Guatemala, donde se publica el blog. */
const TIME_ZONE = 'America/Guatemala';

const months = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
const parts = Object.fromEntries(
	new Intl.DateTimeFormat('en-US', { timeZone: TIME_ZONE, year: 'numeric', month: 'numeric', day: 'numeric' })
		.formatToParts(date)
		.map((part) => [part.type, part.value]),
);
const shortLabel = `${Number(parts.day)} ${months[Number(parts.month) - 1]} ${parts.year}`;
---

<time datetime={date.toISOString()}>
	{
		format === 'short'
			? shortLabel
			: date.toLocaleDateString('es-GT', {
					year: 'numeric',
					month: 'long',
					day: 'numeric',
					timeZone: TIME_ZONE,
				})
	}
</time>
