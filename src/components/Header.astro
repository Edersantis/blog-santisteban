---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
	<a class="skip-link" href="#contenido">Saltar al contenido</a>
	<div class="wrap header-bar">
		<a class="brand" href="/">{SITE_TITLE}</a>
		<div class="header-end">
			<nav class="header-nav" aria-label="Principal">
				<HeaderLink class="nav-link" href="/">Inicio</HeaderLink>
				<HeaderLink class="nav-link" href="/blog/">Blog</HeaderLink>
				<HeaderLink class="nav-link" href="/acerca/">Acerca de</HeaderLink>
			</nav>
			<ThemeToggle />
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 5;
		background: var(--header);
		border-bottom: 1px solid var(--line);
	}
	.header-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 4.25rem;
	}
	.brand {
		color: var(--text);
		font-weight: 560;
		font-size: 0.95rem;
		letter-spacing: -0.02em;
		text-decoration: none;
		white-space: nowrap;
	}
	.brand:hover {
		color: var(--text);
	}
	.header-end {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}
	.header-nav {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}
	.header-nav :global(a.nav-link) {
		color: var(--muted);
		font-size: 0.72rem;
		letter-spacing: 0.14em;
		line-height: 1;
		text-decoration: none;
		text-transform: uppercase;
		white-space: nowrap;
	}
	.header-nav :global(a.nav-link:hover),
	.header-nav :global(a.nav-link.active) {
		color: var(--text);
	}
	.header-nav :global(a.nav-link.active) {
		box-shadow: inset 0 -1px 0 var(--accent);
	}
	.skip-link {
		position: absolute;
		left: 0.75rem;
		top: 0.5rem;
		transform: translateY(-150%);
		background: var(--bg);
		color: var(--text);
		padding: 0.4rem 0.7rem;
		z-index: 6;
	}
	.skip-link:focus {
		transform: none;
	}
	@media (max-width: 720px) {
		.header-nav :global(a.nav-link) {
			letter-spacing: 0.1em;
		}
	}
	@media (max-width: 640px) {
		.header-bar {
			flex-wrap: wrap;
			min-height: 0;
			padding: 0.85rem 0 0.7rem;
			row-gap: 0.55rem;
		}
		.header-end {
			width: 100%;
			justify-content: space-between;
		}
		.header-nav {
			gap: 0.7rem;
		}
	}
</style>
