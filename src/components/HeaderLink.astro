---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

function normalize(path: string) {
	if (path.length > 1 && path.endsWith('/')) return path.slice(0, -1);
	return path;
}

const base = import.meta.env.BASE_URL;
const rawPath = Astro.url.pathname;
const pathname =
	base && base !== '/' && rawPath.startsWith(base) ? `/${rawPath.slice(base.length)}` : rawPath;
const current = normalize(pathname);
const target = normalize(String(href ?? ''));
const isActive =
	target === '/' ? current === '/' || current === '' : current === target || current.startsWith(`${target}/`);
---

<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}>
	<slot />
</a>
