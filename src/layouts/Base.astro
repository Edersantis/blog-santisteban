---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	ogType?: 'website' | 'article';
	pubDate?: Date;
	updatedDate?: Date;
	author?: string;
	tags?: string[];
	mainClass?: string;
}

const { mainClass, ...head } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead {...head} />
	</head>
	<body>
		<Header />
		<main id="contenido" class:list={['wrap', mainClass]}>
			<slot />
		</main>
		<Footer />
	</body>
</html>
