---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';
import Base from './Base.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	readingMinutes: number;
};

const { title, description, pubDate, updatedDate, heroImage, tags, draft, author, readingMinutes } =
	Astro.props;

const readingLabel = readingMinutes === 1 ? '1 min de lectura' : `${readingMinutes} min de lectura`;
---

<Base
	title={title}
	description={description}
	image={heroImage}
	ogType="article"
	pubDate={pubDate}
	updatedDate={updatedDate}
	author={author}
	tags={tags}
>
	<article>
		{
			heroImage && (
				<div class="hero-image">
					<Image
						width={1200}
						height={630}
						src={heroImage}
						alt=""
						loading="eager"
						fetchpriority="high"
					/>
				</div>
			)
		}
		<header class="post-header">
			<p class="meta">
				<span class="meta-part"><FormattedDate date={pubDate} /></span>
				<span class="meta-part">{readingLabel}</span>
				<span class="meta-part">{author}</span>
				{draft && <span class="badge-draft">Borrador</span>}
			</p>
			<h1>{title}</h1>
			{
				updatedDate && (
					<p class="updated">
						Actualizado el <FormattedDate date={updatedDate} />
					</p>
				)
			}
			<TagList tags={tags} />
		</header>
		<div class="prose">
			<slot />
		</div>
	</article>
</Base>

<style>
	.hero-image {
		margin-bottom: 1.5rem;
	}
	.hero-image img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}
	.post-header {
		margin-bottom: 1.5rem;
	}
	.post-header h1 {
		margin: 0.35rem 0 0.5rem;
	}
	.updated {
		margin: 0;
		color: rgb(var(--gray));
		font-style: italic;
		font-size: 0.95rem;
	}
</style>
