---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';
import Base from './Base.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	readingMinutes: number;
};

const { title, description, pubDate, updatedDate, heroImage, tags, draft, author, readingMinutes } =
	Astro.props;

const readingLabel = readingMinutes === 1 ? '1 min de lectura' : `${readingMinutes} min de lectura`;
const isSample = tags.includes('ejemplo');
---

<Base
	title={title}
	description={description}
	image={heroImage}
	ogType="article"
	pubDate={pubDate}
	updatedDate={updatedDate}
	author={author}
	tags={tags}
	mainClass="page"
>
	<article class="post">
		<header class="post-header">
			{isSample && <p class="kicker">Muestra</p>}
			<h1 class="article-title">{title}</h1>
			<p class="meta">
				<span class="meta-part"><FormattedDate date={pubDate} /></span>
				<span class="meta-part">{readingLabel}</span>
				<span class="meta-part">{author}</span>
				{draft && <span class="badge-draft">Borrador</span>}
			</p>
			{
				updatedDate && (
					<p class="updated">
						Actualizado el <FormattedDate date={updatedDate} />
					</p>
				)
			}
			<TagList tags={tags} />
		</header>
		{
			heroImage && (
				<figure class="hero-figure">
					<Image
						width={1600}
						height={1000}
						src={heroImage}
						alt=""
						widths={[480, 768, 1120]}
						sizes="(min-width: 1200px) 1120px, calc(100vw - 2.5rem)"
						loading="eager"
						fetchpriority="high"
					/>
				</figure>
			)
		}
		<div class="prose">
			<slot />
		</div>
	</article>
</Base>
