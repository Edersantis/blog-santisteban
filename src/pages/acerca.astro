---
import Base from '../layouts/Base.astro';

const description = 'Quién es Eder Santisteban. Texto provisional, pendiente de completar.';
---

<Base title="Acerca de" description={description}>
	<h1>Acerca de</h1>
	<p class="placeholder-note">
		Texto provisional. Esta página está lista para que Eder la reescriba con su propia voz.
	</p>
	<p>
		Eder Santisteban da clases en la Universidad Galileo y en Maia, escuela de IA, y trabaja en
		inteligencia artificial y tecnología.
	</p>
	<h2>Pendiente de completar</h2>
	<ul>
		<li>Una presentación en primera persona.</li>
		<li>En qué está trabajando ahora.</li>
		<li>Cómo contactarlo y para qué escribirle.</li>
	</ul>
	<p>
		El sitio principal está en <a href="https://santisteban.co">santisteban.co</a>.
	</p>
</Base>
