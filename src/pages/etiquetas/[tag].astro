---
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { getPublishedPosts, slugifyTag } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const labels = new Map<string, string>();

	for (const post of posts) {
		for (const tag of post.data.tags) {
			const slug = slugifyTag(tag);
			if (slug && !labels.has(slug)) labels.set(slug, tag);
		}
	}

	return [...labels.entries()].map(([tag, label]) => ({
		params: { tag },
		props: { label },
	}));
}

interface Props {
	label: string;
}

const { tag } = Astro.params;
const { label } = Astro.props;
const posts = (await getPublishedPosts()).filter((post) =>
	post.data.tags.some((item) => slugifyTag(item) === tag),
);
---

<Base title={`Etiqueta: ${label}`} description={`Artículos etiquetados con «${label}».`}>
	<p><a href="/etiquetas/">Todas las etiquetas</a></p>
	<h1>{label}</h1>
	<PostList posts={posts} />
</Base>
