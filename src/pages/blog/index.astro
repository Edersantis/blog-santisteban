---
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<Base title="Blog" description="Artículos sobre inteligencia artificial, tecnología y enseñanza." mainClass="page">
	<p class="page-kicker">Archivo</p>
	<h1 class="page-title">Blog</h1>
	<p class="lede">Notas sobre inteligencia artificial aplicada al negocio, al marketing y a la formación.</p>
	<p><a class="back-link" href="/etiquetas/">Etiquetas</a></p>
	<PostList posts={posts} />
</Base>
